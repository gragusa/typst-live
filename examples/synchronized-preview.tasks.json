[
  {
    "label": "Typst: Synchronized Main Preview",
    "command": "zed-typst-preview",
    "args": [
      "start",
      "--root",
      "$ZED_WORKTREE_ROOT",
      "$ZED_WORKTREE_ROOT/main.typ",
      "--",
      "--font-path",
      "$ZED_WORKTREE_ROOT/fonts",
      "--input",
      "draft=true"
    ],
    "save": "none",
    "allow_concurrent_runs": true,
    "reveal": "never"
  },
  {
    "label": "Typst: Synchronized Main Slide Preview",
    "command": "zed-typst-preview",
    "args": [
      "start",
      "--root",
      "$ZED_WORKTREE_ROOT",
      "--mode",
      "slide",
      "$ZED_WORKTREE_ROOT/main.typ",
      "--",
      "--font-path",
      "$ZED_WORKTREE_ROOT/fonts",
      "--input",
      "draft=true"
    ],
    "save": "none",
    "allow_concurrent_runs": true,
    "reveal": "never"
  }
]
