{
  "Heading": {
    "prefix": "typ-heading",
    "body": [
      "${1:=} ${2:Heading} <${3:label}>",
      "$0"
    ],
    "description": "A labeled section heading"
  },
  "Figure": {
    "prefix": "typ-figure",
    "body": [
      "#figure(",
      "  image(\"${1:figure.svg}\", width: ${2:80%}),",
      "  caption: [${3:Caption}],",
      ") <${4:fig-label}>",
      "$0"
    ],
    "description": "An image with a caption and reference label"
  },
  "Table": {
    "prefix": "typ-table",
    "body": [
      "#figure(",
      "  table(",
      "    columns: ${1:2},",
      "    table.header[${2:Column 1}][${3:Column 2}],",
      "    ${4:[Cell 1], [Cell 2],}",
      "  ),",
      "  caption: [${5:Caption}],",
      ") <${6:tab-label}>",
      "$0"
    ],
    "description": "A table with a header, caption, and reference label"
  },
  "Equation": {
    "prefix": "typ-equation",
    "body": [
      "\\$ ${1:y = X beta + epsilon} \\$ <${2:eq-label}>",
      "$0"
    ],
    "description": "A labeled display equation"
  },
  "Aligned equations": {
    "prefix": "typ-align",
    "body": [
      "\\$",
      "  ${1:y} &= ${2:X beta + epsilon} \\\\",
      "  ${3:E[epsilon]} &= ${4:0}",
      "\\$ <${5:eq-label}>",
      "$0"
    ],
    "description": "Display equations aligned on the equals sign"
  },
  "Reference": {
    "prefix": "typ-ref",
    "body": "@${1:label}$0",
    "description": "A cross-reference or bibliography citation"
  },
  "Bibliography": {
    "prefix": "typ-bibliography",
    "body": "#bibliography(\"${1:references.bib}\")$0",
    "description": "A bibliography from a BibTeX or Hayagriva file"
  },
  "Link": {
    "prefix": "typ-link",
    "body": "#link(\"${1:https://example.com}\")[${2:Text}]$0",
    "description": "A hyperlink with display text"
  },
  "Include": {
    "prefix": "typ-include",
    "body": "#include \"${1:section.typ}\"$0",
    "description": "Include another Typst file"
  },
  "Function": {
    "prefix": "typ-function",
    "body": [
      "#let ${1:name}(${2:body}) = {",
      "  $0",
      "}"
    ],
    "description": "A Typst function"
  },
  "Code block": {
    "prefix": "typ-code",
    "body": [
      "```${1:julia}",
      "$0",
      "```"
    ],
    "description": "A fenced code block with a language tag"
  },
  "Page break": {
    "prefix": "typ-pagebreak",
    "body": "#pagebreak()$0",
    "description": "Start a new page"
  }
}
